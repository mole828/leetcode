# Optional settings. Copy to .env and adjust for this machine.
# Existing environment variables take precedence over .env.

# Actual CLI executable; leave unset to discover it via PATH or VS Code.
# LEETCODE_CLI="/path/to/vsc-leetcode-cli/bin/leetcode"

# Problem repository; defaults to the repository containing these scripts.
# Relative paths are resolved from this repository.
# LEETCODE_ROOT="/path/to/another/leetcode"
